<Window x:Class="CodexBackup.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexBackup.App"
        Title="Codex 迁移助手 · 0.3.5 预览版"
        Width="1360"
        Height="930"
        MinWidth="1060"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
 <Window.Resources>
<local:SourceKindChineseConverter x:Key="SourceKindConverter"/>
<local:SourcePriorityBrushConverter x:Key="SourcePriorityBrushConverter"/>
<local:SourceStatusBrushConverter x:Key="SourceStatusBrushConverter"/>
</Window.Resources>
 <Grid>
<Grid.RowDefinitions>
<RowDefinition Height="72"/>
<RowDefinition Height="*"/>
<RowDefinition Height="48"/>
</Grid.RowDefinitions>
 <Border Background="{StaticResource Header}" Padding="30,0">
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="Auto"/>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Teal}" VerticalAlignment="Center">
<TextBlock Text="C" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Border>
<StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
<TextBlock Text="Codex 迁移助手" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
<TextBlock Text="重装前个人数据迁移" Foreground="#AFC8C6" FontSize="12" Margin="0,2,0,0"/>
</StackPanel>
<TextBlock Grid.Column="2" Text="会话 · 项目源码 · 技能 · 记忆" Foreground="#C6D8D7" VerticalAlignment="Center"/>
</Grid>
</Border>
 <Grid Grid.Row="1" Margin="30,20">
<ScrollViewer x:Name="WelcomePage" VerticalScrollBarVisibility="Auto">
<StackPanel MaxWidth="1050" Margin="0,14,0,24">
<TextBlock Text="重装系统前，把真正重要的内容带走" Style="{StaticResource PageTitle}" FontSize="32"/>
<TextBlock Text="一次核对会话、项目源码、技能、记忆库和个人配置，并明确告诉你还有什么没有备齐。" Style="{StaticResource SectionHint}" FontSize="16" Margin="0,8,0,22"/>
<Border Style="{StaticResource Card}" Padding="26">
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="1.05*"/>
<ColumnDefinition Width="28"/>
<ColumnDefinition Width="0.95*"/>
</Grid.ColumnDefinitions>
<StackPanel>
<TextBlock Text="会保存什么" Style="{StaticResource SectionTitle}"/>
<TextBlock Text="会话列表和对话正文&#10;项目源码与 Git 信息&#10;技能、记忆库和个人配置" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="28"/>
<Border Background="{StaticResource TealSoft}" BorderBrush="#B8DED8" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,18,0,0">
<TextBlock Text="程序安装目录、普通日志和缓存可在新系统重新安装或生成，默认不加入备份。" TextWrapping="Wrap" Foreground="#315E5A" LineHeight="21"/>
</Border>
</StackPanel>
<Border Grid.Column="1" Width="1" Background="{StaticResource Line}" HorizontalAlignment="Center"/>
<StackPanel Grid.Column="2">
<TextBlock Text="重装前请先知道" Style="{StaticResource SectionTitle}"/>
<TextBlock Text="• 找不到源码或对话文件时，完整迁移会停止并说明缺少什么。&#10;• 正式备份前请退出 Codex、终端任务和相关工具，再重新扫描。&#10;• 账号登录和云端权限不会复制，新系统需要重新登录。&#10;• 密码保护包一旦忘记密码将无法恢复。&#10;• 验证备份并试恢复后，再清空旧盘。" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="25"/>
</StackPanel>
</Grid>
</Border>
<Border Style="{StaticResource InsetCard}" Background="White">
<StackPanel>
<CheckBox x:Name="RiskAcknowledgement" Content="我理解文件完整、路径关联和实际程序可用性需要分别核对" FontWeight="SemiBold"/>
<Button Content="进入迁移助手" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="4,8,4,0" Click="WelcomeContinue_Click"/>
</StackPanel>
</Border>
</StackPanel>
</ScrollViewer>
 <ScrollViewer x:Name="HomePage" Visibility="Collapsed">
<StackPanel MaxWidth="1120" Margin="0,24">
<TextBlock Text="选择要进行的操作" Style="{StaticResource PageTitle}"/>
<TextBlock Text="备份用于旧系统，恢复用于新系统，检查可在任何阶段独立使用。" Style="{StaticResource SectionHint}" FontSize="14"/>
<UniformGrid Columns="3" Margin="0,20,0,0">
<Button Height="180" Margin="0,0,12,0" Click="OpenBackup_Click">
<StackPanel Margin="12" HorizontalAlignment="Left">
<TextBlock Text="备份" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Teal}"/>
<TextBlock Text="读取真实配置&#10;保存会话与完整源码" Margin="0,13,0,0" TextWrapping="Wrap" LineHeight="25" FontWeight="Normal"/>
</StackPanel>
</Button>
<Button Height="180" Margin="6,0" Click="OpenRestore_Click">
<StackPanel Margin="12" HorizontalAlignment="Left">
<TextBlock Text="恢复" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Teal}"/>
<TextBlock Text="验证备份包&#10;迁移文件与路径关联" Margin="0,13,0,0" TextWrapping="Wrap" LineHeight="25" FontWeight="Normal"/>
</StackPanel>
</Button>
<Button Height="180" Margin="12,0,0,0" Click="OpenCheck_Click">
<StackPanel Margin="12" HorizontalAlignment="Left">
<TextBlock Text="检查" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Teal}"/>
<TextBlock Text="核对当前环境&#10;检查备份包与回滚日志" Margin="0,13,0,0" TextWrapping="Wrap" LineHeight="25" FontWeight="Normal"/>
</StackPanel>
</Button>
</UniformGrid>
</StackPanel>
</ScrollViewer>
<ScrollViewer x:Name="BackupPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel MaxWidth="1320" Margin="0,0,10,24">
 <TextBlock Text="备份个人数据" Style="{StaticResource PageTitle}"/>
<TextBlock Text="从真实配置和会话记录定位数据。完成扫描后，勾选只改变本次备份范围，不会再次读取磁盘。" Style="{StaticResource SectionHint}" Margin="0,6,0,18" FontSize="14"/>
<Border Style="{StaticResource Card}">
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="Auto"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<Border Style="{StaticResource StepBadge}"><TextBlock Text="1" Style="{StaticResource StepNumber}"/></Border>
<StackPanel Grid.Column="1">
<TextBlock Text="一键查找个人数据" Style="{StaticResource SectionTitle}"/>
<TextBlock Text="程序会从 Codex 配置和会话记录追踪其他盘符、外置状态目录与项目源码，并自动选好推荐备份范围。" Style="{StaticResource SectionHint}"/>
<Button Content="一键扫描并推荐" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" MinWidth="220" MinHeight="46" FontSize="15" Margin="0,14,0,8" Click="Scan_Click"/>
<TextBlock Text="通常只需点击上面的按钮。扫描不会修改、移动或删除任何文件。" Foreground="{StaticResource TealDark}" TextWrapping="Wrap"/>
<Expander x:Name="AdvancedScanExpander" Header="高级扫描设置（换过 Windows 用户目录或仍有位置未找到时使用）" IsExpanded="False" Margin="0,12,0,0">
<Border Style="{StaticResource InsetCard}" Margin="0,6,0,0">
<StackPanel>
<TextBlock Text="Windows 用户目录" FontWeight="SemiBold"/>
<DockPanel>
<Button DockPanel.Dock="Right" Content="选择其他用户…" Click="BrowseProfile_Click"/>
<TextBox x:Name="ProfilePathBox"/>
</DockPanel>
<WrapPanel>
<Button Content="添加其他数据位置（任意本地盘）…" Click="AddScanLocation_Click"/>
<Button Content="清除额外位置" Click="ClearScanLocations_Click"/>
</WrapPanel>
<TextBlock x:Name="AdditionalRootsText" Text="自动读取 CODEX_HOME、CODEX_SQLITE_HOME、用户配置、项目引用，以及 Windows 的 %ProgramData%\OpenAI\Codex\config.toml 和 requirements.toml。若仍未找到，再添加你改过的数据目录或它的上级文件夹。" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
</StackPanel>
</Border>
</Expander>
</StackPanel>
</Grid>
</Border>
<Border Style="{StaticResource Card}">
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="Auto"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<Border Style="{StaticResource StepBadge}"><TextBlock Text="2" Style="{StaticResource StepNumber}"/></Border>
<StackPanel Grid.Column="1">
<TextBlock Text="当前判定" Style="{StaticResource SectionTitle}"/>
<TextBlock Text="扫描后先看这里。推荐范围会自动选择，会话与项目源码会一起保存。" Style="{StaticResource SectionHint}"/>
<Border Style="{StaticResource InsetCard}" Margin="4,8,4,8">
<StackPanel>
<TextBlock x:Name="PreflightStatusText" Text="重装判定：尚未扫描" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold"/>
<TextBlock x:Name="CoverageSummaryText" Text="请先扫描。" TextWrapping="Wrap" Margin="0,7,0,0" Foreground="{StaticResource Muted}" LineHeight="21"/>
</StackPanel>
</Border>
<Grid Margin="4,0,4,4">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="12"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<Border Background="{StaticResource TealSoft}" BorderBrush="#B8DED8" BorderThickness="1" CornerRadius="8" Padding="14">
<StackPanel>
<TextBlock Text="推荐备份范围" FontWeight="SemiBold" Foreground="{StaticResource TealDark}"/>
<TextBlock x:Name="RecommendedSelectionSummaryText" Text="扫描后会在这里列出会话、项目、技能、记忆库和个人配置。" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/>
</StackPanel>
</Border>
<Border Grid.Column="2" Background="#F3F0FF" BorderBrush="#CFC5F4" BorderThickness="1" CornerRadius="8" Padding="14">
<StackPanel>
<TextBlock Text="官方旧配置检查" FontWeight="SemiBold" Foreground="#5941A9"/>
<TextBlock x:Name="OfficialAuditSummaryText" Text="扫描后会按 OpenAI 官方配置参考检查已不支持、已弃用和已更名的设置。只提示，不删除。" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/>
</StackPanel>
</Border>
</Grid>
<Expander x:Name="AdvancedBackupExpander" Header="高级备份设置（抢救部分数据、密码保护或重新检查）" IsExpanded="False" Margin="4,10,4,0">
<Border Style="{StaticResource InsetCard}" Margin="0,6,0,0">
<StackPanel>
<TextBlock Text="备份方式" FontWeight="SemiBold"/>
<ComboBox x:Name="BackupModeBox" SelectedIndex="0" SelectionChanged="BackupModeChanged">
<ComboBoxItem Content="完整迁移（推荐）：会话、所有发现的源码和必需文件一起保存"/>
<ComboBoxItem Content="自选 / 抢救：允许部分保存，不能认定为完整迁移"/>
</ComboBox>
<TextBlock Text="密码保护（可选）" FontWeight="SemiBold" Margin="0,8,0,0"/>
<ComboBox x:Name="EncryptionModeBox" SelectedIndex="0" SelectionChanged="EncryptionModeChanged">
<ComboBoxItem Content="普通备份包（兼容性最好，不加密）"/>
<ComboBoxItem Content="密码保护备份包（推荐保存到移动介质）"/>
</ComboBox>
<PasswordBox x:Name="EncryptionPasswordBox" Visibility="Collapsed" Margin="0,6,0,0"/>
<TextBlock Text="密码只在本次操作中使用，不会写入清单。忘记密码无法恢复；加密也不能替代双份备份和恢复验收。" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
<Button Content="重新检查是否齐全" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="4,12,4,0" Click="CheckCoverage_Click"/>
<TextBlock Text="颜色说明：红色=必须处理；黄色=需要核对；蓝色=说明；绿色=已发现；紫色=归档或官方旧配置；灰色=状态未知。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="4,8,4,0"/>
</StackPanel>
</Border>
</Expander>
</StackPanel>
</Grid>
</Border>
<Border Style="{StaticResource Card}" Padding="22,22,22,18">
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="Auto"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<Border Style="{StaticResource StepBadge}"><TextBlock Text="3" Style="{StaticResource StepNumber}"/></Border>
<StackPanel Grid.Column="1">
<TextBlock Text="选择要保住的个人数据" Style="{StaticResource SectionTitle}"/>
<TextBlock Text="推荐内容已经自动选好。大多数情况下无需逐条查看，也不需要自己理解文件路径。" Style="{StaticResource SectionHint}"/>
<Border Background="#F8FAFB" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,2">
<TextBlock Text="默认会保存：会话列表和对话正文、会话关联的项目源码与 Git 信息、技能、记忆库，以及重装后无法自动生成的个人配置。可重新安装的软件、普通日志、缓存和登录令牌默认不保存。" TextWrapping="Wrap" LineHeight="22"/>
</Border>
<Expander x:Name="ManualSelectionExpander" Header="我要自己调整（按会话、类型或归档状态筛选）" IsExpanded="False" Margin="0,12,0,0">
<StackPanel Margin="0,8,0,0">
<TextBlock Text="展开后可以批量选择活动会话、归档会话或某一类数据。选择只改变备份范围，不会重新扫描磁盘。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="2,0,2,8"/>
<TabControl x:Name="BackupContentTabs" Height="38" SelectionChanged="BackupContentTabChanged">
<TabItem x:Name="SessionsTab" Header="会话"/>
<TabItem x:Name="ProjectsTab" Header="项目" ToolTip="项目源码"/>
<TabItem x:Name="MemoriesTab" Header="记忆" ToolTip="记忆库"/>
<TabItem x:Name="PersonalDataTab" Header="会话数据/配置" ToolTip="会话索引、对话正文与个人配置；顶层日志、缓存和登录令牌自动排除"/>
<TabItem x:Name="SkillsTab" Header="技能"/>
<TabItem x:Name="ToolsTab" Header="插件工具" ToolTip="插件与外围工具"/>
<TabItem x:Name="OtherTab" Header="其他" ToolTip="可重新安装的应用状态与手动添加内容"/>
<TabItem x:Name="CleanupTab" Header="清理" ToolTip="归档会话项目中的可重建文件"/>
</TabControl>
<StackPanel x:Name="SourceSelectionPanel" Visibility="Collapsed" Margin="0,14,0,0">
<DockPanel Margin="0,0,0,8">
<TextBlock x:Name="SourceSummaryText" DockPanel.Dock="Right" Margin="14,7,4,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
<TextBlock Text="筛选" VerticalAlignment="Center" Margin="2,0,6,0" Foreground="{StaticResource Muted}"/>
<ComboBox x:Name="SourceFilterBox" Width="150" SelectedIndex="0" SelectionChanged="SourceFilterChanged">
<ComboBoxItem Content="全部"/>
<ComboBoxItem Content="必须保存"/>
<ComboBoxItem Content="已选择"/>
<ComboBoxItem Content="找不到"/>
<ComboBoxItem Content="存在问题"/>
</ComboBox>
<TextBox x:Name="SourceSearchBox" Width="250" ToolTip="按名称、路径或发现依据查找" TextChanged="SourceFilterChanged"/>
</DockPanel>
<WrapPanel Margin="0,0,0,8">
<Button Content="全选当前类型" Style="{StaticResource CompactButton}" Click="SelectVisibleSources_Click"/>
<Button Content="清除当前类型" Style="{StaticResource CompactButton}" Click="ClearVisibleSources_Click"/>
<Button Content="只选必须保存" Style="{StaticResource CompactButton}" Click="SelectRequiredSources_Click"/>
<Button Content="定位已搬走的文件…" Style="{StaticResource CompactButton}" Click="LocateMissing_Click"/>
<Button Content="添加文件夹…" Style="{StaticResource CompactButton}" Click="AddFolder_Click"/>
<Button Content="添加文件…" Style="{StaticResource CompactButton}" Click="AddFile_Click"/>
</WrapPanel>
<DataGrid x:Name="SourcesGrid" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" Height="360">
<DataGrid.Columns>
<DataGridTemplateColumn Header="保存" Width="64">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="SourceSelection_Click">
<CheckBox.Style>
<Style TargetType="CheckBox" BasedOn="{StaticResource GridCheckBox}">
<Style.Triggers>
<DataTrigger Binding="{Binding Required}" Value="True"><Setter Property="IsEnabled" Value="False"/><Setter Property="ToolTip" Value="必须保存，不能取消"/></DataTrigger>
</Style.Triggers>
</Style>
</CheckBox.Style>
</CheckBox>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTemplateColumn Header="重要程度" IsReadOnly="True">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<TextBlock Text="{Binding PriorityText}" Foreground="{Binding PriorityText, Converter={StaticResource SourcePriorityBrushConverter}}" FontWeight="SemiBold"/>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTemplateColumn Header="状态" IsReadOnly="True">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusText, Converter={StaticResource SourceStatusBrushConverter}}" FontWeight="SemiBold"/>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTextColumn Header="类型" Binding="{Binding Kind, Converter={StaticResource SourceKindConverter}}" Width="110" IsReadOnly="True"/>
<DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="170" IsReadOnly="True"/>
<DataGridTextColumn Header="真实文件位置" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
<DataGridTextColumn Header="为什么需要" Binding="{Binding Reason}" Width="250" IsReadOnly="True"/>
</DataGrid.Columns>
</DataGrid>
</StackPanel>
<StackPanel x:Name="SessionSelectionPanel" Margin="0,14,0,0">
<DockPanel Margin="0,0,0,8">
<TextBlock x:Name="SessionSummaryText" DockPanel.Dock="Right" Margin="14,7,4,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
<TextBlock Text="筛选" VerticalAlignment="Center" Margin="2,0,6,0" Foreground="{StaticResource Muted}"/>
<ComboBox x:Name="SessionFilterBox" Width="165" SelectedIndex="0" SelectionChanged="SessionFilterChanged">
<ComboBoxItem Content="全部会话"/>
<ComboBoxItem Content="活动目录"/>
<ComboBoxItem Content="已归档"/>
<ComboBoxItem Content="状态未知"/>
<ComboBoxItem Content="缺少关联文件"/>
<ComboBoxItem Content="归档仍有项目"/>
<ComboBoxItem Content="已选择"/>
</ComboBox>
<TextBox x:Name="SessionSearchBox" Width="250" ToolTip="按标题、编号或路径查找" TextChanged="SessionFilterChanged"/>
</DockPanel>
<WrapPanel Margin="0,0,0,8">
<Button Content="全选当前筛选" Style="{StaticResource CompactButton}" Click="SelectVisibleSessions_Click"/>
<Button Content="清除当前筛选" Style="{StaticResource CompactButton}" Click="ClearVisibleSessions_Click"/>
<Button Content="全选活动" Style="{StaticResource CompactButton}" Click="SelectAllActiveSessions_Click"/>
<Button Content="全选归档" Style="{StaticResource CompactButton}" Click="SelectAllArchivedSessions_Click"/>
<Button Content="全选完整" Style="{StaticResource CompactButton}" Click="SelectCompleteSessions_Click"/>
<Button Content="全选需处理" Style="{StaticResource CompactButton}" Click="SelectProblemSessions_Click"/>
</WrapPanel>
<DataGrid x:Name="SessionsGrid" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" Height="360">
<DataGrid.Columns>
<DataGridTemplateColumn Header="保存" Width="64">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          Style="{StaticResource GridCheckBox}"
          Click="SessionSelection_Click"/>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTemplateColumn Header="状态" IsReadOnly="True">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<TextBlock Text="{Binding LifecycleText}" Foreground="{Binding LifecycleBrush}" FontWeight="SemiBold"/>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTextColumn Header="会话" Binding="{Binding Title}" Width="220" IsReadOnly="True"/>
<DataGridTextColumn Header="最近活动" Binding="{Binding LastActivityUtc}" Width="155" IsReadOnly="True"/>
<DataGridTextColumn Header="关联项目" Binding="{Binding ProjectPath}" Width="*" IsReadOnly="True"/>
<DataGridTemplateColumn Header="提醒" Width="270" IsReadOnly="True">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap"/>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
</DataGrid.Columns>
</DataGrid>
<Border Background="{StaticResource TealSoft}" BorderBrush="#B8DED8" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,8,0,0">
<TextBlock Text="勾选只更新本次备份选择，不扫描磁盘。绿色=活动；紫色=已归档；灰色=状态未知；红色=缺少关联文件。" TextWrapping="Wrap" Foreground="#315E5A"/>
</Border>
</StackPanel>
<StackPanel x:Name="CleanupSelectionPanel" Visibility="Collapsed" Margin="0,14,0,0">
<TextBlock x:Name="CleanupSummaryText" Margin="0,8" TextWrapping="Wrap"/>
<Border Background="{StaticResource WarningSoft}" BorderBrush="#E7B75B" BorderThickness="1" CornerRadius="7" Padding="12">
<TextBlock Text="这里安排的是备份后清理。低风险项是可重新生成的构建目录；高风险项是归档会话记录的整个项目位置，即使没有 Git 或构建标记也会显示，并可能包含源码或其他人工文件。两类都只移动到项目旁的 .codex-backup-quarantine 隔离区，且必须已经被本次验证备份覆盖。活动会话仍使用的项目被锁定。" TextWrapping="Wrap"/>
</Border>
<WrapPanel>
<Button Content="只选低风险可重建目录" Style="{StaticResource CompactButton}" Click="SelectCleanupCandidates_Click"/>
<Button Content="清除选择" Style="{StaticResource CompactButton}" Click="ClearCleanupCandidates_Click"/>
</WrapPanel>
<DataGrid x:Name="CleanupGrid" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" Height="280">
<DataGrid.RowStyle>
<Style TargetType="DataGridRow">
<Setter Property="Foreground" Value="#344054"/>
<Style.Triggers>
<DataTrigger Binding="{Binding ContainsSource}" Value="True">
<Setter Property="Foreground" Value="Firebrick"/>
<Setter Property="FontWeight" Value="SemiBold"/>
</DataTrigger>
<DataTrigger Binding="{Binding IsSharedWithActiveSession}" Value="True">
<Setter Property="Foreground" Value="DimGray"/>
</DataTrigger>
</Style.Triggers>
</Style>
</DataGrid.RowStyle>
<DataGrid.Columns>
<DataGridTemplateColumn Header="备份后隔离" Width="96">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="CleanupSelection_Click">
<CheckBox.Style>
<Style TargetType="CheckBox" BasedOn="{StaticResource GridCheckBox}">
<Style.Triggers>
<DataTrigger Binding="{Binding SafeToQuarantine}" Value="False"><Setter Property="IsEnabled" Value="False"/><Setter Property="ToolTip" Value="活动会话仍在使用，不能清理"/></DataTrigger>
</Style.Triggers>
</Style>
</CheckBox.Style>
</CheckBox>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTextColumn Header="风险" Binding="{Binding RiskText}" Width="150" IsReadOnly="True"/>
<DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="120" IsReadOnly="True"/>
<DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="180" IsReadOnly="True"/>
<DataGridTextColumn Header="关联会话" Binding="{Binding SessionText}" Width="180" IsReadOnly="True"/>
<DataGridTextColumn Header="项目" Binding="{Binding ProjectPath}" Width="*" IsReadOnly="True"/>
<DataGridTextColumn Header="候选目录" Binding="{Binding CandidatePath}" Width="*" IsReadOnly="True"/>
<DataGridTextColumn Header="版本库" Binding="{Binding GitText}" Width="90" IsReadOnly="True"/>
<DataGridTextColumn Header="文件数" Binding="{Binding FileCount}" Width="80" IsReadOnly="True"/>
<DataGridTextColumn Header="估算字节" Binding="{Binding EstimatedBytes}" Width="110" IsReadOnly="True"/>
<DataGridTextColumn Header="最后修改" Binding="{Binding LastModifiedUtc}" Width="150" IsReadOnly="True"/>
<DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="260" IsReadOnly="True"/>
</DataGrid.Columns>
</DataGrid>
<TextBlock Text="红色高风险行必须逐项手动勾选；批量按钮不会选择整个项目。灰色表示活动会话仍引用该项目，不能清理。" Foreground="#8A1C1C" TextWrapping="Wrap" Margin="4,6"/>
<CheckBox x:Name="CleanupConfirmCheck" Content="我理解高风险项包含项目源码和其他人工文件；清理只在备份校验后执行，并会移动到同盘隔离区"/>
<WrapPanel>
<Button x:Name="RunCleanupButton" Content="执行已选隔离清理" IsEnabled="False" Click="RunCleanup_Click"/>
<Button Content="按隔离日志还原…" Click="RestoreCleanup_Click"/>
</WrapPanel>
</StackPanel>
<Expander IsExpanded="False" Margin="0,14,0,0">
<Expander.Header>
<StackPanel Orientation="Horizontal">
<TextBlock Text="需要处理的事项" FontWeight="SemiBold"/>
<TextBlock Text="{Binding ElementName=BackupFindingsList, Path=Items.Count, StringFormat=  ·  {0} 个分组}" Foreground="{StaticResource Muted}"/>
<TextBlock Text="  点击展开" Foreground="{StaticResource Teal}"/>
</StackPanel>
</Expander.Header>
<Border Style="{StaticResource InsetCard}" Margin="0,6,0,0">
<ListBox x:Name="BackupFindingsList" MaxHeight="360" BorderThickness="0" Background="Transparent">
<ListBox.ItemTemplate>
<DataTemplate>
<Expander Header="{Binding Header}" IsExpanded="False" Margin="0,2">
<Expander.HeaderTemplate>
<DataTemplate>
<StackPanel Orientation="Horizontal">
<Border Width="8" Height="20" Background="{Binding AccentBrush}" Margin="0,0,8,0"/>
<TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
<TextBlock Text="  ·  " Foreground="{StaticResource Muted}" Margin="8,0,0,0"/>
<TextBlock Text="{Binding LevelText}" Foreground="{Binding AccentBrush}"/>
</StackPanel>
</DataTemplate>
</Expander.HeaderTemplate>
<ItemsControl ItemsSource="{Binding Items}">
<ItemsControl.ItemTemplate>
<DataTemplate>
<Border BorderBrush="#D0D5DD" BorderThickness="1" Padding="8" Margin="2,3">
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="120"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<StackPanel Grid.Column="0">
<TextBlock Text="{Binding PriorityText}" Foreground="{Binding AccentBrush}" FontWeight="SemiBold"/>
<TextBlock Text="{Binding Category}" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
</StackPanel>
<StackPanel Grid.Column="1">
<TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
<TextBlock Text="{Binding Impact}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
<TextBlock Text="{Binding Action}" TextWrapping="Wrap" Foreground="#344054" Margin="0,3,0,0"/>
<TextBlock Text="{Binding Path}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
</StackPanel>
</Grid>
</Border>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</Expander>
</DataTemplate>
</ListBox.ItemTemplate>
</ListBox>
</Border>
</Expander>
<Expander Header="技术详细记录（排查时查看）">
<TextBox x:Name="TechnicalDetailsBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto"/>
</Expander>
</StackPanel>
</Expander>
</StackPanel>
</Grid>
</Border>
<Border Style="{StaticResource Card}">
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="Auto"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<Border Style="{StaticResource StepBadge}"><TextBlock Text="4" Style="{StaticResource StepNumber}"/></Border>
<StackPanel Grid.Column="1">
<TextBlock Text="选择备份位置并开始" Style="{StaticResource SectionTitle}"/>
<TextBlock Text="优先选择另一块物理硬盘或移动硬盘。开始备份时会重新执行一次完整检查。" Style="{StaticResource SectionHint}"/>
<DockPanel>
<Button DockPanel.Dock="Right" Content="选择保存位置…" Click="BrowseBackupDestination_Click"/>
<TextBox x:Name="BackupDestinationBox"/>
</DockPanel>
<TextBlock x:Name="DestinationInfoText" Text="推荐另一块物理硬盘上的 NTFS 文件夹。不同盘符可能仍在同一块硬盘。" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
<CheckBox x:Name="BackupReviewCheck" Content="我已核对保存位置和密码保护选择，理解密码遗失后无法恢复"/>
<WrapPanel>
<Button Content="返回" Click="BackHome_Click"/>
<Button Content="开始备份并验证" Style="{StaticResource PrimaryButton}" Click="StartBackup_Click"/>
</WrapPanel>
</StackPanel>
</Grid>
</Border>
</StackPanel>
</ScrollViewer>
 <ScrollViewer x:Name="RestorePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
<StackPanel>
<TextBlock Text="恢复：把会话和项目重新连起来" FontSize="26"/>
 <DockPanel Margin="0,12">
<Button DockPanel.Dock="Right" Content="① 选择备份包…" Click="ChooseRestorePackage_Click"/>
<Button DockPanel.Dock="Right" Content="验证" Click="VerifyRestorePackage_Click" Margin="0,0,6,0"/>
<TextBox x:Name="RestorePackageBox" IsReadOnly="True"/>
</DockPanel>
<TextBlock x:Name="RestoreCoverageText" Text="先验证整个备份包。旧版或抢救包不能自动认定为完整。" TextWrapping="Wrap"/>
<Grid Margin="0,8">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="180"/>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="180"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<TextBlock Text="来源 Codex 版本"/>
<TextBlock x:Name="SourceCodexVersionText" Grid.Column="1" Text="未知"/>
<TextBlock Grid.Column="2" Text="目标 Codex 版本（可选）"/>
<TextBox x:Name="TargetCodexVersionBox" Grid.Column="3" ToolTip="安装新系统 Codex 后填写版本；留空不会假定兼容"/>
</Grid>
<Grid Margin="0,0,0,8">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="180"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<TextBlock Text="加密包密码"/>
<PasswordBox x:Name="RestoreEncryptionPasswordBox" Grid.Column="1"/>
</Grid>
<GroupBox Header="主 Codex 会话数据目录（多套时必须明确选择）" Margin="0,0,0,8">
<ListBox x:Name="PrimaryCoreList" MaxHeight="120">
<ListBox.ItemTemplate>
<DataTemplate>
<RadioButton Content="{Binding Display}" IsChecked="{Binding IsPrimary, Mode=TwoWay}" GroupName="PrimaryCore" Checked="PrimaryCore_Checked" Margin="4,4"/>
</DataTemplate>
</ListBox.ItemTemplate>
</ListBox>
</GroupBox>
 <WrapPanel Margin="0,10">
<Button Content="② 恢复原盘符布局" Click="OriginalLayout_Click"/>
<Button Content="② 迁到新的文件夹…" Click="NewLayout_Click"/>
<Button Content="仅解出文件，暂不接入 Codex" Click="IsolatedLayout_Click"/>
</WrapPanel>
<TextBlock Text="迁到新位置时一起计算源码、会话和记忆路径；已有文件不会直接合并。首次使用建议先在独立位置验证。" TextWrapping="Wrap"/>
 <WrapPanel>
<CheckBox x:Name="RequireCompleteCheck" Content="要求会话、项目和必需文件完整关联" IsChecked="True" Click="RestoreOptionChanged"/>
<CheckBox x:Name="IsolatedCheck" Content="只解出文件，不连接应用" IsChecked="True" Click="RestoreOptionChanged"/>
<CheckBox x:Name="ReplaceExistingCheck" Content="允许整项替换已有目标，并保留旧数据" Click="RestoreOptionChanged"/>
</WrapPanel>
 <DataGrid x:Name="MappingsGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="230">
<DataGrid.Columns>
<DataGridCheckBoxColumn Header="恢复" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
<DataGridTextColumn Header="类型" Binding="{Binding Kind, Converter={StaticResource SourceKindConverter}}" IsReadOnly="True"/>
<DataGridTextColumn Header="原位置" Binding="{Binding OriginalPath}" IsReadOnly="True" Width="*"/>
<DataGridTextColumn Header="新位置（可编辑）" Binding="{Binding TargetPath, Mode=TwoWay}" Width="*"/>
</DataGrid.Columns>
</DataGrid>
 <WrapPanel>
<Button Content="仅设置会话主目录" Click="MapCoreToRuntime_Click"/>
<Button Content="③ 检查路径与缺失项" Style="{StaticResource PrimaryButton}" Click="PreviewRestore_Click"/>
<Button Content="④ 执行恢复" Click="ExecuteRestore_Click"/>
</WrapPanel>
<TextBlock Text="账号可能需要重新登录。配置、技能、插件及外围工具的重新启用会单独说明；文件存在不等于电脑已安装项目所需运行环境。" TextWrapping="Wrap" Foreground="#8A5A00" Margin="0,8"/>
 <GroupBox Header="恢复前检查">
<ListBox x:Name="RestorePreviewList" MinHeight="140" MaxHeight="280">
<ListBox.ItemTemplate>
<DataTemplate>
<TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="1020" Margin="4,6"/>
</DataTemplate>
</ListBox.ItemTemplate>
</ListBox>
</GroupBox>
<TextBlock Text="系统级 config.toml 和 requirements.toml 只会恢复到隔离目录，不能直接写入 ProgramData；组织策略、登录状态和云端配置需要在新系统按权限重新启用。" TextWrapping="Wrap" Foreground="#8A5A00" Margin="0,8"/>
<Button Content="返回" HorizontalAlignment="Left" Click="BackHome_Click"/>
</StackPanel>
</ScrollViewer>
 <ScrollViewer x:Name="CheckPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
<StackPanel>
<TextBlock Text="检查与恢复后验收" FontSize="26"/>
<GroupBox Header="当前环境">
<StackPanel>
<TextBlock Text="查看配置所指向的数据，不会修改你的源文件。"/>
<Button Content="扫描当前环境" Click="CheckEnvironment_Click"/>
</StackPanel>
</GroupBox>
<GroupBox Header="备份是否齐全">
<StackPanel>
<DockPanel>
<Button DockPanel.Dock="Right" Content="选择备份包并检查…" Click="VerifyPackage_Click"/>
<TextBox x:Name="CheckPackageBox" IsReadOnly="True"/>
</DockPanel>
<Button Content="显示恢复后的验收步骤" Click="AcceptancePending_Click"/>
</StackPanel>
</GroupBox>
 <GroupBox Header="按日志撤销恢复">
<StackPanel>
<TextBlock Text="请先保存恢复后新写入的工作，程序不会覆盖无法核对的新修改。" TextWrapping="Wrap"/>
<DockPanel>
<Button DockPanel.Dock="Right" Content="选择回滚日志…" Click="ChooseJournal_Click"/>
<TextBox x:Name="JournalPathBox" IsReadOnly="True"/>
</DockPanel>
<CheckBox x:Name="RollbackConfirmCheck" Content="我已核对日志，并保存了恢复后新产生的工作"/>
<Button Content="执行回滚" Click="RunRollback_Click"/>
</StackPanel>
</GroupBox>
<GroupBox Header="结果和下一步">
<ListBox x:Name="CheckResultsList" MinHeight="120">
<ListBox.ItemTemplate>
<DataTemplate>
<TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="1020" Margin="4,6"/>
</DataTemplate>
</ListBox.ItemTemplate>
</ListBox>
</GroupBox>
<Button Content="返回" Click="BackHome_Click"/>
</StackPanel>
</ScrollViewer>
 <ScrollViewer x:Name="ResultPage" Visibility="Collapsed">
<StackPanel MaxWidth="960">
<TextBlock x:Name="ResultTitle" FontSize="28" TextWrapping="Wrap"/>
<TextBlock x:Name="ResultSummary" Margin="0,12" TextWrapping="Wrap" LineHeight="26"/>
<ListBox x:Name="ResultDetails" MinHeight="200">
<ListBox.ItemTemplate>
<DataTemplate>
<TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="900" Margin="4,6"/>
</DataTemplate>
</ListBox.ItemTemplate>
</ListBox>
<WrapPanel>
<Button x:Name="OpenReportButton" Content="打开报告所在位置" Click="OpenResult_Click"/>
<Button Content="返回首页" Click="BackHome_Click"/>
</WrapPanel>
</StackPanel>
</ScrollViewer>
 <Border x:Name="BusyPanel" Visibility="Collapsed" Background="#F2FFFFFF" Panel.ZIndex="10">
<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="550">
<ProgressBar Height="8" IsIndeterminate="True"/>
<TextBlock x:Name="BusyText" FontSize="18" Margin="0,18,0,8" TextAlignment="Center" TextWrapping="Wrap"/>
<TextBlock x:Name="BusyStats" TextAlignment="Center"/>
<Button Content="安全取消" HorizontalAlignment="Center" Click="Cancel_Click"/>
</StackPanel>
</Border>
 </Grid>
<Border Grid.Row="2" Background="White" Padding="24,0">
<DockPanel>
<TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center"/>
<TextBlock Text="离线处理 · 不强制关闭程序 · 缺失不算成功" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
</DockPanel>
</Border>
 </Grid>
</Window>
