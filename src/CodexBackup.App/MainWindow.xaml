<Window x:Class="CodexBackup.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CodexBackup.App" Title="Codex 迁移助手 · 预览版" Width="1120" Height="780" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Window.Resources><local:SourceKindChineseConverter x:Key="SourceKindChineseConverter"/></Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
    <Border Background="#17242D" Padding="24,0"><DockPanel><TextBlock Text="Codex 迁移助手" Foreground="White" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="预览版 · 离线 Windows 工具" Foreground="#B9D4D0" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel></Border>
    <Grid Grid.Row="1" Margin="24,18">
      <ScrollViewer x:Name="WelcomePage" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="820"><TextBlock Text="重装前，先把可迁移内容说清楚" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,14"/><TextBlock Text="此工具按清单备份并逐文件校验，恢复前会先预演。它不能保证所有 Codex 版本、商店包重定向或第三方工具都能被自动识别。" FontSize="16" TextWrapping="Wrap" LineHeight="26"/><GroupBox Header="开始前必须了解"><StackPanel><TextBlock Text="• 备份期间必须关闭可能写入 Codex 数据的程序。&#10;• 未读到、被占用或无法确认的数据不会被当作成功。&#10;• 完整性校验只证明文件包一致；新系统上的 Codex 会话与功能仍需人工验收。&#10;• 默认恢复到隔离目录。替换现有数据属于高风险操作，会另行确认。" TextWrapping="Wrap" LineHeight="25"/></StackPanel></GroupBox><CheckBox x:Name="RiskAcknowledgement" Content="我已阅读并理解以上风险与验收边界"/><Button Content="继续" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="WelcomeContinue_Click"/></StackPanel></ScrollViewer>
      <ScrollViewer x:Name="HomePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="选择要完成的任务" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="每项操作都会显示真实扫描范围、警告与结果。" Foreground="{StaticResource Muted}" Margin="0,5,0,18"/><UniformGrid Columns="3"><Button Height="150" Content="备份&#10;扫描本机并创建校验包" FontSize="17" Click="OpenBackup_Click"/><Button Height="150" Content="恢复&#10;验证包、预演并映射路径" FontSize="17" Click="OpenRestore_Click"/><Button Height="150" Content="检查&#10;环境、备份包或回滚日志" FontSize="17" Click="OpenCheck_Click"/></UniformGrid></StackPanel></ScrollViewer>
      <ScrollViewer x:Name="BackupPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="创建备份" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="1. 选择用户配置目录并扫描；必需项会锁定选择。" Foreground="{StaticResource Muted}"/><DockPanel Margin="0,10"><Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseProfile_Click"/><Button DockPanel.Dock="Right" Content="开始扫描" Style="{StaticResource PrimaryButton}" Click="Scan_Click"/><TextBox x:Name="ProfilePathBox" AutomationProperties.Name="用户配置目录"/></DockPanel><DataGrid x:Name="SourcesGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="270" IsReadOnly="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="选择" Binding="{Binding Selected, Mode=TwoWay}"/><DataGridTextColumn Header="类型" Binding="{Binding Kind, Converter={StaticResource SourceKindChineseConverter}}" IsReadOnly="True"/><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="140" IsReadOnly="True"/><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="260" IsReadOnly="True"/><DataGridTextColumn Header="必需/原因" Binding="{Binding Reason}" Width="190" IsReadOnly="True"/><DataGridTextColumn Header="发现依据" Binding="{Binding DiscoveredBy}" Width="180" IsReadOnly="True"/><DataGridTextColumn Header="修改时间" Binding="{Binding LastModifiedUtc}" IsReadOnly="True"/><DataGridTextColumn Header="活动时间" Binding="{Binding LastActivityUtc}" IsReadOnly="True"/><DataGridTextColumn Header="大小" Binding="{Binding EstimatedBytes}" IsReadOnly="True"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><Button Content="手动添加文件夹" Click="AddFolder_Click"/><Button Content="手动添加文件" Click="AddFile_Click"/></StackPanel><GroupBox Header="扫描范围、警告与错误"><ListBox x:Name="BackupFindingsList" MinHeight="90"/></GroupBox><TextBlock Text="2. 选择备份包保存目录" FontWeight="SemiBold"/><DockPanel><Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseBackupDestination_Click"/><TextBox x:Name="BackupDestinationBox"/></DockPanel><TextBlock x:Name="DestinationInfoText" Text="选择已有目录后显示卷格式与可用空间。盘符不同不代表物理磁盘不同，请自行确认介质。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="4,0"/><CheckBox x:Name="BackupReviewCheck" Content="我确认目标位于可信且有足够空间的位置；备份包不加密，应妥善保管。"/><StackPanel Orientation="Horizontal"><Button Content="返回" Click="BackHome_Click"/><Button Content="创建并校验备份" Style="{StaticResource PrimaryButton}" Click="StartBackup_Click"/></StackPanel></StackPanel></ScrollViewer>
      <ScrollViewer x:Name="RestorePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="恢复备份" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="先验证完整备份包，再选择要恢复的根并编辑目标映射。默认使用隔离目录。" Foreground="{StaticResource Muted}"/><TextBlock Text="支持将单个已知结构的 Codex 核心受控恢复到本机数据目录。适配时配置、凭据、技能、插件和自动化保持停用；恢复后必须重新登录并逐项审核启用。其他根仍保留隔离目标。" TextWrapping="Wrap" Foreground="#8A5A00" Margin="0,6"/><DockPanel Margin="0,10"><Button DockPanel.Dock="Right" Content="选择备份包目录…" Click="ChooseRestorePackage_Click"/><TextBox x:Name="RestorePackageBox" IsReadOnly="True"/></DockPanel><StackPanel Orientation="Horizontal"><CheckBox x:Name="IsolatedCheck" Content="恢复到隔离目录（推荐）" IsChecked="True" Click="RestoreOptionChanged"/><CheckBox x:Name="ReplaceExistingCheck" Content="允许完整替换目标并保留回滚" Click="RestoreOptionChanged"/><Button Content="将所选核心映射到本机 Codex" Click="MapCoreToRuntime_Click"/></StackPanel><DataGrid x:Name="MappingsGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="210"><DataGrid.Columns><DataGridCheckBoxColumn Header="恢复" Binding="{Binding Selected, Mode=TwoWay}"/><DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="80" IsReadOnly="True"/><DataGridTextColumn Header="备份中的原路径" Binding="{Binding OriginalPath}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="恢复到" Binding="{Binding TargetPath, Mode=TwoWay}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><Button Content="预演恢复" Style="{StaticResource PrimaryButton}" Click="PreviewRestore_Click"/><Button Content="执行恢复" Click="ExecuteRestore_Click"/></StackPanel><GroupBox Header="预演项目与阻断项"><ListBox x:Name="RestorePreviewList" MinHeight="120"/></GroupBox><StackPanel Orientation="Horizontal"><Button Content="返回" Click="BackHome_Click"/></StackPanel></StackPanel></ScrollViewer>
      <ScrollViewer x:Name="CheckPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="检查与恢复后验收" FontSize="26" FontWeight="SemiBold"/><GroupBox Header="当前环境扫描"><StackPanel><TextBlock Text="只读扫描当前用户配置与已知 Codex 位置，显示覆盖不足。"/><Button Content="扫描当前环境" HorizontalAlignment="Left" Click="CheckEnvironment_Click"/></StackPanel></GroupBox><GroupBox Header="完整备份包校验"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="选择目录并校验…" Click="VerifyPackage_Click"/><TextBox x:Name="CheckPackageBox" IsReadOnly="True"/></DockPanel><Button Content="记录恢复后人工验收待办" HorizontalAlignment="Left" Click="AcceptancePending_Click"/><TextBlock Text="文件校验通过不等于 Codex 应用层验收通过。请在新系统手动检查登录、会话、项目、技能和记忆。" TextWrapping="Wrap" Foreground="#8A5A00"/></StackPanel></GroupBox><GroupBox Header="回滚恢复（会修改数据）"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="选择回滚日志…" Click="ChooseJournal_Click"/><TextBox x:Name="JournalPathBox" IsReadOnly="True"/></DockPanel><CheckBox x:Name="RollbackConfirmCheck" Content="我理解回滚会修改当前文件，并已确认选择的是正确日志"/><Button Content="执行回滚" HorizontalAlignment="Left" Click="RunRollback_Click"/></StackPanel></GroupBox><GroupBox Header="检查结果"><ListBox x:Name="CheckResultsList" MinHeight="120"/></GroupBox><Button Content="返回" HorizontalAlignment="Left" Click="BackHome_Click"/></StackPanel></ScrollViewer>
      <ScrollViewer x:Name="ResultPage" Visibility="Collapsed"><StackPanel MaxWidth="820"><TextBlock x:Name="ResultTitle" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="ResultSummary" Margin="0,12" TextWrapping="Wrap" LineHeight="24"/><ListBox x:Name="ResultDetails" MinHeight="180"/><StackPanel Orientation="Horizontal"><Button x:Name="OpenReportButton" Content="在文件资源管理器中打开" Click="OpenResult_Click"/><Button Content="返回首页" Click="BackHome_Click"/></StackPanel></StackPanel></ScrollViewer>
      <Border x:Name="BusyPanel" Visibility="Collapsed" Background="#EFFFFFFF" Panel.ZIndex="10"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460"><ProgressBar Height="8" IsIndeterminate="True"/><TextBlock x:Name="BusyText" Text="正在处理…" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,8" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="BusyStats" TextAlignment="Center" Foreground="{StaticResource Muted}"/><Button Content="取消" HorizontalAlignment="Center" Click="Cancel_Click"/></StackPanel></Border>
    </Grid>
    <Border Grid.Row="2" Background="White" BorderBrush="#D9E0E1" BorderThickness="0,1,0,0" Padding="24,0"><DockPanel><TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><TextBlock Text="不联网 · 备份包可能包含凭据，且不会自动加密" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></DockPanel></Border>
  </Grid>
</Window>
